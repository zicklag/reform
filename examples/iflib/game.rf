# Metadata and parsers related to the game itself.

$ rule (parse start the game)
    (
        - queue stmt-start Start the game stmt-end $( $queue )*
    )
    (
        queue
            stmt-start
                enact starting-game
            stmt-end
            $( $queue )*
    )

The status of the game is starting.

# Carry-out staring-game:
#     say ```
#         Game by Author
        
#         ```;
#     enact printing-prelude;
#     enact looking

$ rule (carry out enacting start of game)
    (
        - queue
            stmt-start
                enact starting-game
            stmt-end
            $( $queue )*
    )
    (
        queue
            stmt-start
                say ```
                    Game by Author

                    ```
            stmt-end
            stmt-start
                enact printing-prelude
            stmt-end
            stmt-start
                enact looking
            stmt-end
    )
