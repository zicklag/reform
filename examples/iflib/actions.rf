# Here we setup actions, which progress in phases. The default phase rules
# will progress an action through the phases automatically.
# 
# Other rules may respond to the action in the different phases, and if they
# consume the fact, they can prevent the action from moving to later phases.
# If they do not consume the fact, then multiple rules may respond to the same
# action.
# 
# The phases are:
# 
# 1. Before - before enacting $action
# 2. Instead - instead-of enacting $action
# 3. Check - check enacting $action
# 4. Carry out - carry-out enacting $action
# 5. After - after enacting $action

$ rule (parse enact action statement)
    (
        - queue
            stmt-start
                enact $action
            stmt-end
            $( $queue )*
    )
    (
        queue
            stmt-start
                before-enacting $action
            stmt-end
            $( $queue )*
    )

$ rule (transition from before to instead phase)
    (
        - queue
            stmt-start
                before-enacting $action
            stmt-end
            $( $queue )*
    )
    (
        queue
            stmt-start
                instead-of-enacting $action
            stmt-end
            $( $queue )*
    )
    
$ rule (transition from instead to check phase)
    (
        - queue
            stmt-start
                instead-of-enacting $action
            stmt-end
            $( $queue )*
    )
    (
        queue
            stmt-start
                check-enacting $action
            stmt-end
            $( $queue )*
    )
    
$ rule (transition from check to carry-out phase)
    (
        - queue
            stmt-start
                check-enacting $action
            stmt-end
            $( $queue )*
    )
    (
        queue
            stmt-start
                carry-out-enacting $action
            stmt-end
            $( $queue )*
    )
    
$ rule (transition from carry-out to after phase)
    (
        - queue
            stmt-start
                carry-out-enacting $action
            stmt-end
            $( $queue )*
    )
    (
        queue
            stmt-start
                after-enacting $action
            stmt-end
            $( $queue )*
    )
    
$ rule (clean up after phase)
    (
        - queue
            stmt-start
                after-enacting $action
            stmt-end
            $( $queue )*
    )
    (
        queue $( $queue )*
    )

#
# Add some parse parsers for creating rules rules for the
# actions
# 

before is before-token
Before is before-token
$ rule (parse before rule statement)
    (
        - queue
            stmt-start
                $before $action $( cond-rule $( $rule )+ end-cond )* : $( $words )+
            stmt-end
            $( $queue )*
        $before is before-token
    )
    (
        rule (before $action rule)
            (
                - queue
                    stmt-start
                        before-enacting $action
                    stmt-end
                    $$( $$queue )*
                $($($rule )+
                )*
            )
            (
                queue
                    stmt-start
                        $( $words )+
                    stmt-end
                    $$( $$queue )*
            )
        queue $( $queue )*
    )
    

carry-out is carry-out-token
Carry-out is carry-out-token
$ rule (parse carry-out rule statement)
    (
        - queue
            stmt-start
                $carry-out $action : $( $( $first_words )+ ;  )** $( $( $last_words )* )?
            stmt-end
            $( $queue )*
        $carry-out is carry-out-token
    )
    (
        rule (carry-out $action rule)
            (
                - queue
                    stmt-start
                        carry-out-enacting $action
                    stmt-end
                    $$( $$queue )*
            )
            (
                queue
                    $(
                        stmt-start
                            $( $first_words )+
                        stmt-end
                    )**
                    $(
                        stmt-start
                            $( $last_words )*
                        stmt-end
                    )?
                    $$( $$queue )*
            )
        queue $( $queue )*
    )
    
after is after-token
After is after-token
$ rule (parse after rule statement)
    (
        - queue
            stmt-start
                $after $action : $( $( $first_words )+ ;  )** $( $( $last_words )* )?
            stmt-end
            $( $queue )*
        $after is after-token
    )
    (
        rule (after $action rule)
            (
                after enacting $action
            )
            (
                $(
                    parse $( $first_words )+
                )**
                $(
                    parse $( $last_words )*
                )?
            )
        queue $( $queue )*
    )