$ rule (parse after rule statement)
    (
        - parse $after $action : $( $( $first_words )+ ;  )** $( $last_words )+
    )
    (
        rule (after $action rule)
            (
                after enacting $action
            )
            (
                $(
                    parse $( $first_words )+
                )**
                parse $( $last_words )+
            )
    )

Carry-out test:
    say `hi`;
    say `bye`

$ facts