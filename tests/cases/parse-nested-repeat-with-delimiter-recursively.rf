$ rule (parse example)
    (
        - parse Example $( $chunk )+ ; $( $rest )+
    )
    (
        parsed $( $chunk )+
        parse Example $( $rest )+
    )

$ rule (parse final example)
    (
        - parse Example $( $last )+
    )
    (
        parsed $( $last )+
    )

Example
    hello world;
    goodbye world;
    testing delimiter

$ facts
$ assert parsed hello world
$ assert parsed goodbye world
$ assert parsed testing delimiter
$ assert-not parse Example
$ assert-not parsed hello world (;) goodbye world
